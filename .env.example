# App
APP_ENV=development
APP_NAME=Flus24 Manager
PORT=3001
API_PREFIX=api/v1
# Comma-separated list of origins allowed to call this API with credentials (CORS)
FRONTEND_ORIGINS=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=project7_auth

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Reversible encryption for stored third-party credentials (e.g. Flussonic server
# API passwords/tokens) that the app must be able to read back. Generate with:
#   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=change-this-64-char-hex-key-0000000000000000000000000000

# Razorpay (wallet top-up) — from the Razorpay dashboard's API keys / webhook settings
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-this-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=change-this-razorpay-webhook-secret
